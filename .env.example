# Select one backend for descriptions, dietary inference, and embeddings.
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-key
GEMINI_API_KEY=replace-with-your-key
# Optional model overrides; domain code does not reference these names.
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# AI_PROVIDER=qwen is embedding-only and keyless (runs locally via sentence-transformers).
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_BATCH_SIZE=32
# Optional pacing; defaults to 60 for OpenAI, 10 for Gemini.
# AI_REQUESTS_PER_MINUTE=60
# Docker database; local Postgres.app users should use their local role.
DATABASE_URL=postgresql://order_assistant:order_assistant@localhost:5432/order_assistant
